DJANGO_DEBUG=true
# Replace with a long, private value before deployment. The backend refuses the placeholder in production.
DJANGO_SECRET_KEY=development-only-change-before-deploy
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_TIME_ZONE=Asia/Kathmandu
# Set true only behind a trusted HTTPS proxy that overwrites X-Forwarded-Proto.
# DJANGO_TRUST_X_FORWARDED_PROTO=true

# Optional for local development. If omitted, the backend uses SQLite and an in-memory Channels layer.
# DATABASE_URL=postgresql://qenilo:qenilo@127.0.0.1:5432/qenilo
# REDIS_URL=redis://127.0.0.1:6379/0

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
GOOGLE_OAUTH_CLIENT_ID=
STUN_SERVER_URLS=stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478
# Optional TURN relay. Keep the shared secret on the backend only; TURN credentials are generated per signed-in user.
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
# TURN_SHARED_SECRET=replace-with-the-secret-configured-on-your-coturn-server
# Development-only public relay (shared credentials; less reliable than a project account):
# TURN_URLS=turn:staticauth.openrelay.metered.ca:80?transport=tcp,turn:staticauth.openrelay.metered.ca:443?transport=tcp,turns:staticauth.openrelay.metered.ca:443?transport=tcp
# TURN_SHARED_SECRET=openrelayprojectsecret
# Or use Cloudflare Realtime TURN. Create a TURN key and a token restricted to TURN credential generation.
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=
TURN_CREDENTIAL_TTL_SECONDS=3600
# Tune these limits for your expected traffic; sign-in and Google sign-in are keyed by client IP.
AUTH_LOGIN_RATE=5/min
AUTH_REGISTER_RATE=5/hour
AUTH_GOOGLE_RATE=10/min
